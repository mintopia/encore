{
  "name": "@mintopia/encore",
  "version": "2.1.0",
  "description": "Authenticating WebSocket proxy + supervisor for Spotify Soloist.",
  "license": "MIT",
  "author": "Jessica Smith <jess@mintopia.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mintopia/encore.git"
  },
  "homepage": "https://github.com/mintopia/encore#readme",
  "bugs": "https://github.com/mintopia/encore/issues",
  "type": "module",
  "bin": {
    "encore": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc && vite build && node -e \"require('fs').cpSync('src/web','dist/web',{recursive:true})\"",
    "build:backend": "tsc && node -e \"require('fs').cpSync('src/web','dist/web',{recursive:true})\"",
    "start": "node dist/main.js",
    "dev": "npm run build && node dist/main.js",
    "dev:web": "vite",
    "build:web": "vite build",
    "typecheck:web": "tsc --noEmit -p src/web-vue/tsconfig.json",
    "test": "npm run build && node dist/selftest.js",
    "test:backend": "npm run build:backend && SOLOIST_TEST_BACKEND_ONLY=1 node dist/selftest.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "highlight.js": "^11.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.13"
  }
}
